{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chancytsonga",
  "compatibility_date": "2026-04-07",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    { "pattern": "chancytsonga.com/*", "custom_domain": true },
    { "pattern": "www.chancytsonga.com/*", "custom_domain": true }
  ]
}
